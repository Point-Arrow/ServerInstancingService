{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthBackend": {
    "BaseUrl": "airwars.online",
    "SessionValidationPath": "/Db/Profile/Session/Validate",
    "TimeoutSeconds": 10
  },
  "GameServer": {
    "_valuesOfLauncherType": "Local - process launching, Docker - docker launching",
    "LauncherType": "Local",
    "IpAddress": "127.0.0.1",
    "MaxConcurrentServers": 10,
    "PortRangeStart": 7000,
    "PortRangeEnd": 7100
  }
}
